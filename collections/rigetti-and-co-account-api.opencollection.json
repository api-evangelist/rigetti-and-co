            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qcs.rigetti.com/v1/groups/:groupName/balance",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "URL encoded name of group for which to retrieve account balance."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the balance of the requested QCS group account."
        },
