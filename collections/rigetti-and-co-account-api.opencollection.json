            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qcs.rigetti.com/v1/groups/:groupName/users",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "URL encoded name of group for which to retrieve users."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
